{
	"name": "polyfillme",
	"version": "1.0.4",
	"description": "Scan JS files for unsupported features and generate polyfill file.",
	"main": "src/index.js",
	"scripts": {
		"build": "echo 'no build step - stopgap for CI coverage-badge'",
		"build:ci": "echo '✓ no build step'",
		"build:mdn": "node ./src/data/scripts/mdn-js-features-info.js",
		"test": "node tests/run-vitest.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage"
	},
	"keywords": [
		"polyfill",
		"compatibility",
		"es",
		"ecma",
		"core-js",
		"ast"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"espree": "^9.0.0",
		"fast-glob": "^3.0.0",
		"polyfill-library": "^4.8.0"
	},
	"devDependencies": {
		"@cldmv/vitest-runner": "^1.2.0",
		"@eslint/js": "^9.31.0",
		"@eslint/json": "^0.13.0",
		"@mdn/browser-compat-data": "^6.0.33",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^9.31.0",
		"globals": "^16.3.0",
		"prettier": "^3.9.6",
		"vitest": "^4.1.10"
	}
}
